
<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <title><%= content_for(:title) || "GPA Engenharia - Portal Técnico" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0b1b35">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Aplicar tema antes de renderizar a página -->
    <script>
      (() => {
        try {
          const saved = localStorage.getItem("gpa-theme");
          const systemLight = window.matchMedia(
            "(prefers-color-scheme: light)"
          ).matches;

          document.documentElement.dataset.theme =
            saved === "light" || saved === "dark"
              ? saved
              : (systemLight ? "light" : "dark");
        } catch (_) {}
      })();
    </script>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="gpa-body">
    <% if user_signed_in? %>

      <div
        class="gpa-shell"
        data-controller="gpa-shell"
        data-action="keydown.esc@window->gpa-shell#closeMenu"
      >

        <!-- Overlay do menu mobile -->
        <button
          type="button"
          class="gpa-backdrop"
          aria-label="Fechar menu"
          data-gpa-shell-target="backdrop"
          data-action="click->gpa-shell#closeMenu"
          hidden
        ></button>

        <!-- ===================================
             SIDEBAR
             =================================== -->
        <aside
          id="gpa-sidebar"
          class="gpa-sidebar"
          aria-label="Navegação principal"
          data-gpa-shell-target="sidebar"
        >

          <!-- Logo e identificação -->
          <div class="gpa-brand-bar">

            <%= link_to dashboard_path,
              class: "gpa-brand",
              data: { action: "click->gpa-shell#navigate" } do %>

              <span class="gpa-brand-icon">
                GPA
              </span>

              <span class="gpa-brand-copy">
                <strong>GPA Engenharia</strong>
                <small>Portal Técnico</small>
              </span>

            <% end %>

            <!-- Fechar menu no celular -->
            <button
              type="button"
              class="gpa-icon-button gpa-sidebar-close"
              aria-label="Fechar menu"
              data-action="click->gpa-shell#closeMenu"
            >
              <%= gpa_icon(:close) %>
            </button>

          </div>

          <!-- ===================================
               NAVEGAÇÃO
               =================================== -->
          <nav class="gpa-navigation" aria-label="Menu principal">

            <p class="gpa-nav-caption">
              Área de trabalho
            </p>

            <% navigation = [
              ["Dashboard", dashboard_path, :dashboard],
              ["Condomínios", condominios_path, :building],
              ["Feed Técnico", post_tecnicos_path, :feed],
              ["Estoque", estoque_root_path, :package],
              ["Garantias", estoque_garantias_path, :shield]
            ] %>

            <% navigation.each do |label, path, icon| %>

              <% active =
                current_page?(path) ||
                (
                  path != dashboard_path &&
                  request.path.start_with?(path.sub(/\/$/, "") + "/")
                )
              %>

              <%= link_to path,
                class: "gpa-nav-link #{'is-active' if active}",
                title: label,
                aria: { current: (active ? "page" : nil) },
                data: { action: "click->gpa-shell#navigate" } do %>

                <%= gpa_icon(icon) %>

                <span class="gpa-nav-label">
                  <%= label %>
                </span>

              <% end %>
            <% end %>

            <!-- Área administrativa -->
            <% if current_user.admin? %>

              <p class="gpa-nav-caption gpa-admin-caption">
                Administração
              </p>

              <% active_users =
                request.path == admin_users_path ||
                request.path.start_with?(
                  admin_users_path.sub(/\/$/, "") + "/"
                )
              %>

              <%= link_to admin_users_path,
                class: "gpa-nav-link #{'is-active' if active_users}",
                title: "Usuários",
                aria: { current: (active_users ? "page" : nil) },
                data: { action: "click->gpa-shell#navigate" } do %>

                <%= gpa_icon(:users) %>

                <span class="gpa-nav-label">
                  Usuários
                </span>

              <% end %>
            <% end %>

          </nav>

          <!-- ===================================
               RODAPÉ DA SIDEBAR
               =================================== -->
          <div class="gpa-sidebar-bottom">

            <!-- Recolher sidebar no desktop -->
            <button
              type="button"
              class="gpa-nav-link gpa-collapse-button"
              title="Recolher ou expandir menu"
              aria-label="Recolher ou expandir menu"
              data-action="click->gpa-shell#toggleCollapse"
            >

              <%= gpa_icon(:panel) %>

              <span class="gpa-nav-label">
                Recolher menu
              </span>

            </button>

            <!-- Identificação do usuário -->
            <details class="gpa-user-menu">

              <summary
                class="gpa-user-summary"
                title="Minha conta"
              >

                <!-- Avatar apenas na sidebar -->
                <span class="gpa-avatar">
                  <%= current_user.nome.to_s.first.presence&.upcase || "U" %>
                </span>

                <span class="gpa-user-copy">

                  <strong>
                    <%= current_user.nome.presence || current_user.email %>
                  </strong>

                  <small>
                    <%= current_user.role %>
                  </small>

                </span>

                <%= gpa_icon(:chevron) %>

              </summary>

              <!-- Dropdown do usuário -->
              <div class="gpa-user-dropdown">

                <div class="gpa-dropdown-heading">

                  <strong>
                    <%= current_user.nome.presence || current_user.email %>
                  </strong>

                  <small>
                    <%= current_user.email %>
                  </small>

                </div>

                <% if current_user.admin? %>

                  <%= link_to "Novo usuário",
                    new_admin_user_path,
                    class: "gpa-dropdown-link" %>

                  <%= link_to "Editar meu usuário",
                    edit_admin_user_path(current_user),
                    class: "gpa-dropdown-link" %>

                  <%= link_to "Lista de usuários",
                    admin_users_path,
                    class: "gpa-dropdown-link" %>

                <% end %>

                <!-- Logout -->
                <%= button_to destroy_user_session_path,
                  method: :delete,
                  form: { data: { turbo: false } },
                  class: "gpa-dropdown-link gpa-signout" do %>

                  Sair da conta

                <% end %>

              </div>

            </details>

          </div>

        </aside>

        <!-- ===================================
             ÁREA PRINCIPAL
             =================================== -->
        <div class="gpa-main-area">

          <!-- HEADER -->
          <header class="gpa-topbar">

            <div class="gpa-topbar-start">

              <!-- Menu mobile -->
              <button
                type="button"
                class="gpa-icon-button gpa-mobile-menu"
                aria-label="Abrir menu"
                aria-controls="gpa-sidebar"
                aria-expanded="false"
                data-gpa-shell-target="menuButton"
                data-action="click->gpa-shell#toggleMenu"
              >

                <%= gpa_icon(:menu) %>

              </button>

              <!-- Título da página -->
              <div class="gpa-heading-wrap">

                <span class="gpa-eyebrow">
                  GPA Engenharia / Portal Técnico
                </span>

                <h1 class="gpa-page-heading">
                  <%= content_for?(:page_title) ?
                    yield(:page_title) : "Dashboard" %>
                </h1>

              </div>

            </div>

            <!-- Ações do cabeçalho -->
            <div class="gpa-topbar-actions">

              <!-- Data -->
              <span class="gpa-topbar-date">
                <%= l(Date.current, format: :long) rescue Date.current.strftime("%d/%m/%Y") %>
              </span>

              <!-- Botão de alternância de tema -->
              <button
                type="button"
                class="gpa-icon-button gpa-theme-button"
                aria-label="Alternar tema claro e escuro"
                title="Alternar tema"
                aria-pressed="false"
                data-gpa-shell-target="themeButton"
                data-action="click->gpa-shell#toggleTheme"
              >

                <!-- Ícone exibido no tema escuro -->
                <span class="gpa-show-in-dark">
                  <%= gpa_icon(:sun) %>
                </span>

                <!-- Ícone exibido no tema claro -->
                <span class="gpa-show-in-light">
                  <%= gpa_icon(:moon) %>
                </span>

              </button>

              <!--
                Avatar removido deste cabeçalho.
                A identificação fica apenas na sidebar.
              -->

            </div>

          </header>

          <!-- ===================================
               MENSAGENS DO SISTEMA
               =================================== -->

          <% if notice.present? %>

            <div
              class="gpa-flash gpa-flash-success"
              role="status"
            >
              <%= notice %>
            </div>

          <% end %>

          <% if alert.present? %>

            <div
              class="gpa-flash gpa-flash-danger"
              role="alert"
            >
              <%= alert %>
            </div>

          <% end %>

          <!-- ===================================
               CONTEÚDO DAS PÁGINAS
               =================================== -->
          <main id="conteudo" class="gpa-content">

            <%= yield %>

          </main>

          <!-- RODAPÉ -->
          <footer class="gpa-footer">

            © <%= Date.current.year %> GPA Engenharia ·
            Portal Técnico · Versão 1.0.0

          </footer>

        </div>

      </div>

    <% else %>

      <!-- Layout para usuários não autenticados -->
      <main class="gpa-guest">
        <%= yield %>
      </main>

    <% end %>

    <!-- ===================================
         NOTIFICAÇÕES DO ESTOQUE
         =================================== -->
    <% if user_signed_in? %>

      <div
        data-controller="notificacoes-estoque"
        data-notificacoes-estoque-url-value="<%= estoque_notificacoes_transferencias_pendentes_path %>"
      ></div>

    <% end %>

  </body>
</html>
