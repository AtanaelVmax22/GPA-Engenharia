
<% condominio = @condominio || historico.condominio %>

<% formulario_modelo =
  historico.new_record? ?
    [condominio, historico] :
    historico
%>

<%= form_with model: formulario_modelo,
  class: "gpa-form",
  multipart: true do |f| %>

  <!-- ERROS -->
  <% if historico.errors.any? %>
    <div class="gpa-form-errors" role="alert">
      <strong>
        Não foi possível salvar o atendimento.
      </strong>

      <ul>
        <% historico.errors.full_messages.each do |mensagem| %>
          <li><%= mensagem %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- INFORMAÇÕES -->
  <section class="gpa-panel">
    <div class="gpa-panel-header">
      <div>
        <h2 class="gpa-panel-title">Registro Técnico</h2>
        <p class="gpa-panel-subtitle">
          Informações do atendimento realizado.
        </p>
      </div>
    </div>

    <div class="gpa-form-grid">

      <div class="gpa-field">
        <%= f.label :tipo, "Tipo de Atendimento",
          class: "gpa-form-label" %>

        <%= f.select :tipo,
          HistoricoTecnico.tipos.keys.map { |tipo|
            [tipo.humanize, tipo]
          },
          {},
          class: "gpa-input gpa-select" %>
      </div>

      <div class="gpa-field">
        <%= f.label :status, "Status",
          class: "gpa-form-label" %>

        <%= f.select :status,
          HistoricoTecnico.statuses.keys.map { |status|
            [status.humanize, status]
          },
          {},
          class: "gpa-input gpa-select" %>
      </div>

      <div class="gpa-field gpa-field-full">
        <%= f.label :titulo, "Título do Atendimento",
          class: "gpa-form-label" %>

        <%= f.text_field :titulo,
          class: "gpa-input",
          placeholder: "Ex.: Manutenção preventiva realizada" %>
      </div>

      <div class="gpa-field">
        <%= f.label :equipamento_id, "Equipamento",
          class: "gpa-form-label" %>

        <%= f.select :equipamento_id,
          condominio.equipamentos.map { |e|
            [e.nome, e.id]
          },
          { include_blank: "Nenhum / Atendimento geral" },
          class: "gpa-input gpa-select" %>
      </div>

      <div class="gpa-field">
        <%= f.label :data_atendimento, "Data e Hora",
          class: "gpa-form-label" %>

        <%= f.datetime_local_field :data_atendimento,
          class: "gpa-input" %>
      </div>

      <div class="gpa-field gpa-field-full">
        <%= f.label :descricao, "Descrição do Serviço",
          class: "gpa-form-label" %>

        <%= f.text_area :descricao,
          rows: 6,
          class: "gpa-input gpa-textarea",
          placeholder: "Descreva o serviço realizado..." %>
      </div>

      <div class="gpa-field gpa-field-full">
        <%= f.label :pecas_utilizadas, "Peças Utilizadas",
          class: "gpa-form-label" %>

        <%= f.text_area :pecas_utilizadas,
          rows: 3,
          class: "gpa-input gpa-textarea",
          placeholder: "Informe as peças e quantidades utilizadas..." %>
      </div>

    </div>
  </section>

  <!-- FOTOS -->
  <section class="gpa-panel">

    <div class="gpa-panel-header">
      <div>
        <h2 class="gpa-panel-title">
          Evidências Fotográficas
        </h2>

        <p class="gpa-panel-subtitle">
          Anexe fotos do equipamento, local ou serviço.
        </p>
      </div>
    </div>

    <% if historico.persisted? && historico.fotos.attached? %>
      <div class="gpa-photo-existing">
        <h3>Fotos já cadastradas</h3>

        <div class="gpa-photo-grid">
          <% historico.fotos.attachments.select(&:persisted?).each do |foto| %>

            <!-- Preserva as fotos já anexadas -->
            <%= f.hidden_field :fotos,
              multiple: true,
              value: foto.blob.signed_id %>

            <div class="gpa-photo-card">

              <%= link_to url_for(foto),
                target: "_blank",
                rel: "noopener noreferrer" do %>

                <%= image_tag foto,
                  class: "gpa-photo-image",
                  loading: "lazy",
                  alt: "Foto do atendimento" %>

              <% end %>

              <div class="gpa-photo-caption">
                <%= foto.filename.to_s %>
              </div>

            </div>
          <% end %>
        </div>

        <p class="gpa-photo-hint">
          As fotos existentes serão preservadas.
          Para excluir uma foto, abra os detalhes
          do atendimento.
        </p>
      </div>
    <% end %>

    <div class="gpa-upload-area">

      <div class="gpa-upload-icon">
        <%= gpa_icon(:plus) %>
      </div>

      <%= f.label :fotos, "Adicionar fotos",
        class: "gpa-form-label" %>

      <%= f.file_field :fotos,
        multiple: true,
        accept: "image/jpeg,image/png,image/webp",
        class: "gpa-file-input" %>

      <p class="gpa-photo-hint">
        Selecione fotos da câmera ou galeria.
        Formatos: JPG, PNG e WebP.
        Máximo de 10 MB por foto e 10 fotos por atendimento.
      </p>

    </div>

  </section>

  <!-- AÇÕES -->
  <div class="gpa-form-footer">
    <%= f.submit(
      historico.new_record? ?
        "Registrar Atendimento" :
        "Salvar Alterações",
      class: "gpa-btn gpa-btn-primary"
    ) %>

    <%= link_to "Cancelar",
      historico.new_record? ?
        condominio_path(condominio) :
        historico_tecnico_path(historico),
      class: "gpa-btn gpa-btn-secondary" %>
  </div>

<% end %>
