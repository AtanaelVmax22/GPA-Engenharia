
<% content_for :page_title, @historico.titulo %>

<div class="gpa-module">

  <div>
    <%= link_to condominio_historico_tecnicos_path(@historico.condominio),
      class: "gpa-back-link" do %>
      <span>←</span>
      <span>Voltar ao Histórico Técnico</span>
    <% end %>
  </div>

  <!-- DADOS PRINCIPAIS -->
  <section class="gpa-panel">

    <div class="gpa-detail-header">
      <div class="gpa-detail-identity">

        <span class="gpa-condominio-icon gpa-detail-icon">
          <%= gpa_icon(:feed) %>
        </span>

        <div class="gpa-detail-title">
          <h2><%= @historico.titulo %></h2>
          <p><%= @historico.condominio.nome %></p>

          <div class="gpa-historico-badges">
            <%= tipo_badge(@historico.tipo) %>
            <%= status_badge(@historico.status) %>
          </div>
        </div>

      </div>

      <div class="gpa-detail-actions">
        <%= link_to edit_historico_tecnico_path(@historico),
          class: "gpa-btn gpa-btn-primary" do %>
          <%= gpa_icon(:edit) %>
          <span>Editar Atendimento</span>
        <% end %>
      </div>
    </div>

    <dl class="gpa-info-grid">

      <div class="gpa-info-item">
        <dt>Data do Atendimento</dt>
        <dd>
          <%= @historico.data_atendimento&.strftime("%d/%m/%Y às %H:%M") || "Não informada" %>
        </dd>
      </div>

      <div class="gpa-info-item">
        <dt>Técnico Responsável</dt>
        <dd>
          <%= @historico.user&.nome.presence ||
            @historico.user&.email ||
            "Não informado" %>
        </dd>
      </div>

      <div class="gpa-info-item">
        <dt>Equipamento</dt>
        <dd>
          <% if @historico.equipamento.present? %>
            <%= link_to @historico.equipamento.nome,
              equipamento_path(@historico.equipamento),
              class: "gpa-text-link" %>
          <% else %>
            Atendimento geral
          <% end %>
        </dd>
      </div>

      <div class="gpa-info-item">
        <dt>Categoria</dt>
        <dd>
          <%= @historico.equipamento&.categoria.presence || "—" %>
        </dd>
      </div>

    </dl>
  </section>

  <!-- DESCRIÇÃO -->
  <section class="gpa-panel">

    <div class="gpa-panel-header">
      <h2 class="gpa-panel-title">
        Descrição do Serviço
      </h2>
    </div>

    <% if @historico.descricao.present? %>
      <div class="gpa-historico-text">
        <%= simple_format(@historico.descricao) %>
      </div>
    <% else %>
      <div class="gpa-inline-empty">
        Nenhuma descrição registrada.
      </div>
    <% end %>

  </section>

  <!-- PEÇAS -->
  <% if @historico.pecas_utilizadas.present? %>
    <section class="gpa-panel">

      <div class="gpa-panel-header">
        <h2 class="gpa-panel-title">
          Peças Utilizadas
        </h2>
      </div>

      <div class="gpa-historico-text">
        <%= simple_format(@historico.pecas_utilizadas) %>
      </div>

    </section>
  <% end %>

  <!-- GALERIA DE FOTOS -->
  <section class="gpa-panel">

    <div class="gpa-panel-header">
      <div>
        <h2 class="gpa-panel-title">
          Fotos do Atendimento
        </h2>

        <p class="gpa-panel-subtitle">
          Evidências fotográficas do serviço.
        </p>
      </div>

      <span class="gpa-count-badge">
        <%= @historico.fotos.size %> fotos
      </span>
    </div>

    <% if @historico.fotos.attached? %>

      <div class="gpa-photo-grid">

        <% @historico.fotos.each do |foto| %>

          <article class="gpa-photo-card">

            <!-- Visualizar foto -->
            <%= link_to url_for(foto),
              target: "_blank",
              rel: "noopener noreferrer",
              title: "Ampliar foto" do %>

              <%= image_tag foto,
                class: "gpa-photo-image",
                loading: "lazy",
                alt: "Foto do atendimento #{@historico.titulo}" %>

            <% end %>

            <div class="gpa-photo-card-footer">

              <span class="gpa-photo-filename">
                <%= foto.filename.to_s %>
              </span>

              <!-- Excluir individualmente -->
              <%= button_to "Excluir",
                remover_foto_historico_tecnico_path(
                  @historico,
                  foto_id: foto.id
                ),
                method: :delete,
                class: "gpa-photo-delete",
                form: {
                  data: {
                    turbo_confirm: "Deseja excluir esta foto permanentemente?"
                  }
                } %>

            </div>
          </article>

        <% end %>

      </div>

    <% else %>

      <div class="gpa-inline-empty">
        Nenhuma foto cadastrada neste atendimento.
      </div>

    <% end %>

    <div class="gpa-photo-actions">

      <%= link_to edit_historico_tecnico_path(@historico),
        class: "gpa-btn gpa-btn-secondary" do %>

        <%= gpa_icon(:plus) %>
        <span>Adicionar Fotos</span>

      <% end %>

    </div>
  </section>

</div>
