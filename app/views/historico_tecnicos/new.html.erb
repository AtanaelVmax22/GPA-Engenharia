
<% content_for :page_title, "Novo Registro Técnico" %>

<div class="gpa-module gpa-form-page">

  <%= link_to condominio_historico_tecnicos_path(@condominio),
    class: "gpa-back-link" do %>

    <span>←</span>
    <span>Voltar ao Histórico Técnico</span>

  <% end %>

  <div class="gpa-module-header">

    <div class="gpa-module-heading">

      <h2>Novo Atendimento Técnico</h2>

      <p>
        Registre o serviço realizado no condomínio
        <strong><%= @condominio.nome %></strong>.
      </p>

    </div>

  </div>

  <%= render "form", historico: @historico %>

</div>
