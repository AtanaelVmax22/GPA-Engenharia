
<% content_for :page_title, "Novo Equipamento" %>

<div class="gpa-module gpa-form-page">

  <%= link_to condominio_path(@condominio),
    class: "gpa-back-link" do %>

    <span>←</span>
    <span>Voltar para <%= @condominio.nome %></span>

  <% end %>

  <div class="gpa-module-header">

    <div class="gpa-module-heading">
      <h2>Cadastrar Equipamento</h2>

      <p>
        Adicione um novo equipamento técnico ao condomínio
        <strong><%= @condominio.nome %></strong>.
      </p>
    </div>

  </div>

  <%= render "form", equipamento: @equipamento %>

</div>
