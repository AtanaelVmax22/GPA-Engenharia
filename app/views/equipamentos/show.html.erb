
<% content_for :page_title, @equipamento.nome %>

<div class="gpa-module">

  <!-- VOLTAR -->
  <div>
    <%= link_to condominio_path(@equipamento.condominio),
      class: "gpa-back-link" do %>
      <span>←</span>
      <span><%= @equipamento.condominio.nome %></span>
    <% end %>
  </div>

  <!-- DADOS DO EQUIPAMENTO -->
  <section class="gpa-panel">

    <div class="gpa-detail-header">

      <div class="gpa-detail-identity">

        <div class="gpa-detail-title">

          <h2><%= @equipamento.nome %></h2>

          <p>
            <%= @equipamento.categoria.presence || "Sem categoria" %>
            ·
            <%= @equipamento.condominio.nome %>
          </p>

          <div class="gpa-detail-status">
            <%= status_badge(@equipamento.status) %>
          </div>

        </div>
      </div>

      <div class="gpa-detail-actions">
        <%= link_to "Editar Equipamento",
          edit_equipamento_path(@equipamento),
          class: "gpa-btn gpa-btn-primary" %>
      </div>

    </div>

    <!-- INFORMAÇÕES TÉCNICAS -->
    <dl class="gpa-info-grid">

      <div class="gpa-info-item">
        <dt>Marca</dt>
        <dd><%= @equipamento.marca.presence || "Não informada" %></dd>
      </div>

      <div class="gpa-info-item">
        <dt>Modelo</dt>
        <dd><%= @equipamento.modelo.presence || "Não informado" %></dd>
      </div>

      <div class="gpa-info-item">
        <dt>Número de Série</dt>
        <dd><%= @equipamento.numero_serie.presence || "Não informado" %></dd>
      </div>

      <div class="gpa-info-item">
        <dt>Data de Instalação</dt>
        <dd>
          <%= @equipamento.data_instalacao&.strftime("%d/%m/%Y") || "Não informada" %>
        </dd>
      </div>

      <% if @equipamento.localizacao.present? %>
        <div class="gpa-info-item gpa-info-full">
          <dt>Localização</dt>
          <dd><%= @equipamento.localizacao %></dd>
        </div>
      <% end %>

      <% if @equipamento.observacoes.present? %>
        <div class="gpa-info-item gpa-info-full">
          <dt>Observações</dt>
          <dd class="whitespace-pre-line">
            <%= @equipamento.observacoes %>
          </dd>
        </div>
      <% end %>

    </dl>

  </section>

  <!-- HISTÓRICO DE MANUTENÇÃO -->
  <section class="gpa-panel">

    <div class="gpa-panel-header">
      <div>
        <h2 class="gpa-panel-title">
          Histórico de Manutenção
        </h2>

        <p class="gpa-panel-subtitle">
          Atendimentos realizados neste equipamento.
        </p>
      </div>

      <%= link_to "Ver histórico do condomínio",
        condominio_historico_tecnicos_path(@equipamento.condominio),
        class: "gpa-btn gpa-btn-secondary" %>
    </div>

    <% if @historicos.present? %>

      <div class="gpa-record-list">

        <% @historicos.each do |historico| %>

          <article class="gpa-record-item">

            <div class="gpa-record-content">

              <%= tipo_badge(historico.tipo) %>

              <%= link_to historico.titulo,
                historico_tecnico_path(historico),
                class: "gpa-record-title gpa-record-link" %>

              <p class="gpa-record-subtitle">
                <%= historico.user&.nome.presence ||
                    historico.user&.email ||
                    "Técnico não informado" %>
                ·
                <%= historico.data_atendimento&.strftime("%d/%m/%Y") || "Sem data" %>
              </p>

            </div>

            <div class="gpa-record-actions">
              <%= status_badge(historico.status) %>
            </div>

          </article>

        <% end %>

      </div>

    <% else %>

      <div class="gpa-inline-empty">
        Nenhuma manutenção registrada para este equipamento.
      </div>

    <% end %>

  </section>

</div>
