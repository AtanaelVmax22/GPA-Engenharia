
<%= form_with(
  model: equipamento.new_record? ? [@condominio, equipamento] : equipamento,
  class: "gpa-form"
) do |f| %>

  <!-- ERROS DE VALIDAÇÃO -->
  <% if equipamento.errors.any? %>

    <div class="gpa-form-errors" role="alert">

      <strong>
        Não foi possível salvar o equipamento.
      </strong>

      <ul>
        <% equipamento.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>

    </div>

  <% end %>

  <!-- DADOS DO EQUIPAMENTO -->
  <section class="gpa-panel">

    <div class="gpa-panel-header">
      <div>
        <h2 class="gpa-panel-title">
          Informações do Equipamento
        </h2>

        <p class="gpa-panel-subtitle">
          Identificação, categoria e situação operacional.
        </p>
      </div>
    </div>

    <div class="gpa-form-grid">

      <!-- NOME -->
      <div class="gpa-field gpa-field-full">
        <%= f.label :nome, "Nome do Equipamento",
          class: "gpa-form-label" %>

        <%= f.text_field :nome,
          class: "gpa-input",
          placeholder: "Ex.: Câmera IP Portaria" %>
      </div>

      <!-- CATEGORIA -->
      <div class="gpa-field">
        <%= f.label :categoria, "Categoria",
          class: "gpa-form-label" %>

        <%= f.select :categoria,
          Equipamento::CATEGORIAS,
          {},
          class: "gpa-input gpa-select" %>
      </div>

      <!-- STATUS -->
      <div class="gpa-field">
        <%= f.label :status, "Status",
          class: "gpa-form-label" %>

        <%= f.select :status,
          Equipamento.statuses.keys.map { |s| [s.humanize, s] },
          {},
          class: "gpa-input gpa-select" %>
      </div>

      <!-- MARCA -->
      <div class="gpa-field">
        <%= f.label :marca, "Marca",
          class: "gpa-form-label" %>

        <%= f.text_field :marca,
          class: "gpa-input",
          placeholder: "Fabricante" %>
      </div>

      <!-- MODELO -->
      <div class="gpa-field">
        <%= f.label :modelo, "Modelo",
          class: "gpa-form-label" %>

        <%= f.text_field :modelo,
          class: "gpa-input",
          placeholder: "Modelo do equipamento" %>
      </div>

      <!-- NÚMERO DE SÉRIE -->
      <div class="gpa-field">
        <%= f.label :numero_serie, "Número de Série",
          class: "gpa-form-label" %>

        <%= f.text_field :numero_serie,
          class: "gpa-input",
          placeholder: "Número de série" %>
      </div>

      <!-- DATA DE INSTALAÇÃO -->
      <div class="gpa-field">
        <%= f.label :data_instalacao, "Data de Instalação",
          class: "gpa-form-label" %>

        <%= f.date_field :data_instalacao,
          class: "gpa-input" %>
      </div>

      <!-- LOCALIZAÇÃO -->
      <div class="gpa-field gpa-field-full">
        <%= f.label :localizacao, "Localização no Condomínio",
          class: "gpa-form-label" %>

        <%= f.text_field :localizacao,
          class: "gpa-input",
          placeholder: "Ex.: Garagem, portaria social, casa de máquinas..." %>
      </div>

    </div>

  </section>

  <!-- OBSERVAÇÕES -->
  <section class="gpa-panel">

    <div class="gpa-panel-header">
      <div>
        <h2 class="gpa-panel-title">
          Observações Técnicas
        </h2>

        <p class="gpa-panel-subtitle">
          Informações adicionais sobre a instalação ou equipamento.
        </p>
      </div>
    </div>

    <div class="gpa-field">

      <%= f.label :observacoes, "Observações",
        class: "gpa-form-label" %>

      <%= f.text_area :observacoes,
        rows: 5,
        class: "gpa-input gpa-textarea",
        placeholder: "Registre observações relevantes sobre o equipamento..." %>

    </div>

  </section>

  <!-- AÇÕES -->
  <div class="gpa-form-footer">

    <%= f.submit(
      equipamento.new_record? ?
        "Cadastrar Equipamento" :
        "Salvar Alterações",
      class: "gpa-btn gpa-btn-primary"
    ) %>

    <%= link_to "Cancelar",
      condominio_path(@condominio),
      class: "gpa-btn gpa-btn-secondary" %>

  </div>

<% end %>
