
<% content_for :page_title, @condominio.nome %>

<div class="gpa-module">

  <!-- Voltar -->
  <div>
    <%= link_to condominios_path,
      class: "gpa-back-link" do %>
      <span>←</span>
      Voltar para Condomínios
    <% end %>
  </div>

  <!-- Informações principais -->
  <section class="gpa-panel">

    <div class="gpa-detail-header">

      <div class="gpa-detail-identity">
        <span class="gpa-condominio-icon gpa-detail-icon">
          <%= gpa_icon(:building) %>
        </span>

        <div class="gpa-detail-title">
          <h2><%= @condominio.nome %></h2>

          <p>
            <%= @condominio.endereco_completo.presence ||
              "Endereço não informado" %>
          </p>

          <div class="gpa-detail-status">
            <%= status_badge(@condominio.status) %>
          </div>
        </div>
      </div>

      <div class="gpa-detail-actions">

        <%= link_to new_condominio_equipamento_path(@condominio),
          class: "gpa-btn gpa-btn-secondary" do %>
          <%= gpa_icon(:plus) %>
          <span>Equipamento</span>
        <% end %>

        <%= link_to new_condominio_historico_tecnico_path(@condominio),
          class: "gpa-btn gpa-btn-secondary" do %>
          <%= gpa_icon(:plus) %>
          <span>Histórico</span>
        <% end %>

        <%= link_to new_condominio_checklist_path(@condominio),
          class: "gpa-btn gpa-btn-secondary" do %>
          <%= gpa_icon(:plus) %>
          <span>Checklist</span>
        <% end %>

        <%= link_to edit_condominio_path(@condominio),
          class: "gpa-btn gpa-btn-primary" do %>
          <%= gpa_icon(:edit) %>
          <span>Editar</span>
        <% end %>

      </div>
    </div>

    <!-- Dados -->
    <dl class="gpa-info-grid">

      <div class="gpa-info-item">
        <dt>Síndico</dt>
        <dd>
          <%= @condominio.sindico_nome.presence || "Não informado" %>
        </dd>
      </div>

      <div class="gpa-info-item">
        <dt>Telefone</dt>
        <dd>
          <% if @condominio.sindico_telefone.present? %>
            <%= link_to @condominio.sindico_telefone,
              "tel:#{@condominio.sindico_telefone.gsub(/[^\d+]/, '')}",
              class: "gpa-text-link" %>
          <% else %>
            Não informado
          <% end %>
        </dd>
      </div>

      <div class="gpa-info-item">
        <dt>E-mail</dt>
        <dd>
          <% if @condominio.sindico_email.present? %>
            <%= mail_to @condominio.sindico_email,
              @condominio.sindico_email,
              class: "gpa-text-link" %>
          <% else %>
            Não informado
          <% end %>
        </dd>
      </div>

      <div class="gpa-info-item">
        <dt>Unidades</dt>
        <dd><%= @condominio.unidades || "—" %></dd>
      </div>

      <% if @condominio.observacoes.present? %>
        <div class="gpa-info-item gpa-info-full">
          <dt>Observações</dt>
          <dd class="gpa-preserve-lines">
            <%= @condominio.observacoes %>
          </dd>
        </div>
      <% end %>

    </dl>
  </section>

  <!-- Equipamentos e atendimentos -->
  <div class="gpa-detail-columns">

    <!-- Equipamentos -->
    <section class="gpa-panel">
      <div class="gpa-panel-header">
        <div>
          <h2 class="gpa-panel-title">
            Equipamentos Instalados
          </h2>
          <p class="gpa-panel-subtitle">
            Equipamentos vinculados ao condomínio
          </p>
        </div>

        <span class="gpa-count-badge">
          <%= @equipamentos.size %>
        </span>
      </div>

      <% if @equipamentos.any? %>

        <% @equipamentos.group_by(&:categoria).each do |categoria, equipamentos| %>

          <div class="gpa-equipment-group">

            <h3 class="gpa-category-heading">
              <%= categoria.presence || "Sem categoria" %>
            </h3>

            <% equipamentos.each do |equipamento| %>

              <div class="gpa-record-item">

                <div class="gpa-record-content">
                  <p class="gpa-record-title">
                    <%= equipamento.nome %>
                  </p>

                  <p class="gpa-record-subtitle">
                    <%= equipamento.localizacao.presence ||
                      equipamento.modelo.presence ||
                      "Localização não informada" %>
                  </p>
                </div>

                <div class="gpa-record-actions">
                  <%= status_badge(equipamento.status) %>

                  <%= link_to "Ver",
                    equipamento_path(equipamento),
                    class: "gpa-text-link" %>
                </div>

              </div>
            <% end %>

          </div>
        <% end %>

      <% else %>
        <div class="gpa-inline-empty">
          Nenhum equipamento cadastrado.
        </div>
      <% end %>

    </section>

    <!-- Histórico técnico -->
    <section class="gpa-panel">

      <div class="gpa-panel-header">
        <div>
          <h2 class="gpa-panel-title">
            Histórico de Atendimentos
          </h2>
          <p class="gpa-panel-subtitle">
            Registros técnicos recentes
          </p>
        </div>

        <%= link_to "Ver todos",
          condominio_historico_tecnicos_path(@condominio),
          class: "gpa-text-link" %>
      </div>

      <% if @historicos.any? %>

        <div class="gpa-record-list">

          <% @historicos.each do |historico| %>

            <div class="gpa-record-item gpa-history-item">

              <div class="gpa-record-content">

                <div class="gpa-record-type">
                  <%= tipo_badge(historico.tipo) %>
                </div>

                <%= link_to historico.titulo,
                  historico,
                  class: "gpa-record-title gpa-record-link" %>

                <p class="gpa-record-subtitle">
                  <%= historico.user&.nome.presence || "Usuário não informado" %>
                  ·
                  <%= historico.data_atendimento ?
                    historico.data_atendimento.strftime("%d/%m/%Y") :
                    "Sem data" %>
                </p>
              </div>

              <div class="gpa-record-actions">
                <%= status_badge(historico.status) %>
              </div>

            </div>

          <% end %>

        </div>

      <% else %>
        <div class="gpa-inline-empty">
          Nenhum registro técnico encontrado.
        </div>
      <% end %>

    </section>

  </div>
</div>
