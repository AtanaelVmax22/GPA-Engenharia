
<% content_for :page_title, "Condomínios" %>

<div class="gpa-module">

  <!-- Cabeçalho -->
  <div class="gpa-module-header">
    <div class="gpa-module-heading">
      <h2>Gestão de Condomínios</h2>
      <p>
        Consulte e gerencie os condomínios cadastrados,
        seus equipamentos e informações técnicas.
      </p>
    </div>

    <%= link_to new_condominio_path,
      class: "gpa-btn gpa-btn-primary" do %>
      <%= gpa_icon(:plus) %>
      <span>Novo Condomínio</span>
    <% end %>
  </div>

  <!-- Pesquisa e filtros -->
  <section class="gpa-panel gpa-filter-panel">
    <%= form_with url: condominios_path,
      method: :get,
      class: "gpa-filter-form" do |f| %>

      <div class="gpa-filter-search">
        <%= f.label :q, "Buscar condomínio",
          class: "gpa-form-label" %>

        <%= f.text_field :q,
          value: params[:q],
          placeholder: "Buscar pelo nome do condomínio...",
          class: "gpa-input",
          autocomplete: "off" %>
      </div>

      <div class="gpa-filter-status">
        <%= f.label :status, "Situação",
          class: "gpa-form-label" %>

        <%= f.select :status,
          [
            ["Todos os status", ""],
            ["Ativos", "ativo"],
            ["Inativos", "inativo"]
          ],
          { selected: params[:status] },
          class: "gpa-input gpa-select" %>
      </div>

      <div class="gpa-filter-actions">
        <%= f.submit "Buscar",
          class: "gpa-btn gpa-btn-primary" %>

        <%= link_to "Limpar",
          condominios_path,
          class: "gpa-btn gpa-btn-secondary" %>
      </div>
    <% end %>
  </section>

  <!-- Quantidade na página atual -->
  <div class="gpa-results-heading">
    <h3>Condomínios encontrados</h3>
    <span class="gpa-count-badge">
      <%= @condominios.size %> nesta página
    </span>
  </div>

  <!-- Lista de cartões -->
  <% if @condominios.any? %>

    <div class="gpa-condominio-grid">
      <% @condominios.each do |condominio| %>

        <article class="gpa-condominio-card">

          <div class="gpa-condominio-card-top">
            <span class="gpa-condominio-icon">
              <%= gpa_icon(:building) %>
            </span>

            <div class="gpa-condominio-identification">
              <h3>
                <%= link_to condominio.nome,
                  condominio_path(condominio),
                  class: "gpa-condominio-name" %>
              </h3>

              <p>
                <%= [
                  condominio.cidade.presence,
                  condominio.estado.presence
                ].compact.join(", ").presence || "Localização não informada" %>
              </p>
            </div>
          </div>

          <div class="gpa-condominio-status">
            <%= status_badge(condominio.status) %>
          </div>

          <!-- Informações -->
          <dl class="gpa-condominio-details">
            <div>
              <dt>Síndico</dt>
              <dd>
                <%= condominio.sindico_nome.presence || "Não informado" %>
              </dd>
            </div>

            <div>
              <dt>Unidades</dt>
              <dd><%= condominio.unidades || "—" %></dd>
            </div>

            <div>
              <dt>Equipamentos</dt>
              <dd><%= condominio.equipamentos.count %></dd>
            </div>

            <div>
              <dt>Última visita</dt>
              <dd>
                <%= condominio.ultima_visita ?
                  l(condominio.ultima_visita, format: :short) :
                  "Não registrada" %>
              </dd>
            </div>
          </dl>

          <!-- Ações -->
          <div class="gpa-condominio-actions">
            <%= link_to condominio_path(condominio),
              class: "gpa-btn gpa-btn-secondary gpa-card-main-action" do %>

              <span>Ver detalhes</span>
              <%= gpa_icon(:arrow) %>
            <% end %>

            <%= link_to edit_condominio_path(condominio),
              class: "gpa-btn gpa-btn-outline" do %>
              <%= gpa_icon(:edit) %>
              <span>Editar</span>
            <% end %>
          </div>

        </article>
      <% end %>
    </div>

  <% else %>

    <!-- Estado vazio -->
    <div class="gpa-empty-state">
      <div class="gpa-empty-icon">
        <%= gpa_icon(:building) %>
      </div>

      <h3>Nenhum condomínio encontrado</h3>

      <p>
        Não encontramos condomínios com os filtros
        selecionados.
      </p>

      <%= link_to "Cadastrar condomínio",
        new_condominio_path,
        class: "gpa-btn gpa-btn-primary" %>
    </div>

  <% end %>

  <!-- Paginação -->
  <% if @pagy && @pagy.pages > 1 %>
    <nav class="gpa-pagination" aria-label="Paginação de condomínios">
      <%== pagy_nav(@pagy) %>
    </nav>
  <% end %>

</div>
