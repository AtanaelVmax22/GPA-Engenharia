<% content_for :page_title do %>
  Gerenciar Usuários
<% end %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-bold text-zinc-100">Usuários</h2>
      <p class="text-sm text-zinc-500">Gerencie acessos, permissões, cadastro e exclusão de usuários.</p>
    </div>

    <%= link_to "Novo usuário", new_admin_user_path,
      class: "px-4 py-2 bg-amber-500 hover:bg-amber-400 text-zinc-950 font-semibold rounded-lg text-sm" %>
  </div>

  <div class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-zinc-800/70 text-zinc-400">
        <tr>
          <th class="px-4 py-3 text-left">Nome</th>
          <th class="px-4 py-3 text-left">E-mail</th>
          <th class="px-4 py-3 text-left">Telefone</th>
          <th class="px-4 py-3 text-left">Permissão</th>
          <th class="px-4 py-3 text-right">Ações</th>
        </tr>
      </thead>

      <tbody class="divide-y divide-zinc-800">
        <% @users.each do |user| %>
          <tr class="hover:bg-zinc-800/40">
            <td class="px-4 py-3 text-zinc-100">
              <%= user.nome.presence || "Sem nome" %>

              <% if user == current_user %>
                <span class="ml-2 text-xs text-amber-400">(você)</span>
              <% end %>
            </td>

            <td class="px-4 py-3 text-zinc-400">
              <%= user.email %>
            </td>

            <td class="px-4 py-3 text-zinc-400">
              <%= user.telefone.presence || "-" %>
            </td>

            <td class="px-4 py-3">
              <% if user.admin? %>
                <span class="px-2 py-1 rounded bg-amber-500/20 text-amber-300 text-xs font-semibold">
                  Admin
                </span>
              <% else %>
                <span class="px-2 py-1 rounded bg-zinc-700 text-zinc-300 text-xs font-semibold">
                  Técnico
                </span>
              <% end %>
            </td>

            <td class="px-4 py-3 text-right space-x-2">
              <%= link_to "Editar", edit_admin_user_path(user),
                class: "text-amber-400 hover:text-amber-300" %>

              <% unless user == current_user %>
                <%= link_to "Excluir", admin_user_path(user),
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "Tem certeza que deseja excluir este usuário?"
                  },
                  class: "text-red-400 hover:text-red-300" %>
              <% end %>
            </td>
          </tr>
        <% end %>

        <% if @users.empty? %>
          <tr>
            <td colspan="5" class="px-4 py-6 text-center text-zinc-500">
              Nenhum usuário cadastrado.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>