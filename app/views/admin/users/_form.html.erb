<%= form_with model: [:admin, @user], class: "space-y-5" do |form| %>
  <% if @user.errors.any? %>
    <div class="px-4 py-3 bg-red-900/50 border border-red-700 text-red-300 rounded-lg text-sm">
      <p class="font-semibold mb-2">Corrija os erros abaixo:</p>

      <ul class="list-disc pl-5 space-y-1">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :nome, "Nome", class: "block text-sm text-zinc-300 mb-1" %>
    <%= form.text_field :nome,
      class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100 focus:outline-none focus:border-amber-500" %>
  </div>

  <div>
    <%= form.label :email, "E-mail", class: "block text-sm text-zinc-300 mb-1" %>
    <%= form.email_field :email,
      class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100 focus:outline-none focus:border-amber-500" %>
  </div>

  <div>
    <%= form.label :telefone, "Telefone", class: "block text-sm text-zinc-300 mb-1" %>
    <%= form.text_field :telefone,
      class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100 focus:outline-none focus:border-amber-500" %>
  </div>

  <div>
    <%= form.label :role, "Permissão", class: "block text-sm text-zinc-300 mb-1" %>
    <%= form.select :role,
      User.roles.keys.map { |role| [role.humanize, role] },
      {},
      class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100 focus:outline-none focus:border-amber-500" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= form.label :password, @user.persisted? ? "Nova senha" : "Senha", class: "block text-sm text-zinc-300 mb-1" %>
      <%= form.password_field :password,
        autocomplete: "new-password",
        class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100 focus:outline-none focus:border-amber-500" %>

      <% if @user.persisted? %>
        <p class="text-xs text-zinc-500 mt-1">Deixe em branco para manter a senha atual.</p>
      <% end %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirmar senha", class: "block text-sm text-zinc-300 mb-1" %>
      <%= form.password_field :password_confirmation,
        autocomplete: "new-password",
        class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100 focus:outline-none focus:border-amber-500" %>
    </div>
  </div>

  <div class="flex items-center justify-between pt-4">
    <%= link_to "Voltar", admin_users_path,
      class: "px-4 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-sm" %>

    <%= form.submit @user.persisted? ? "Salvar alterações" : "Criar usuário",
      class: "px-5 py-2 bg-amber-500 hover:bg-amber-400 text-zinc-950 font-semibold rounded-lg text-sm cursor-pointer" %>
  </div>
<% end %>