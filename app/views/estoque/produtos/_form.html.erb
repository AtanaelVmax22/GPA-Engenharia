<%= form_with model: @produto,
  url: @produto.persisted? ? estoque_produto_path(@produto) : estoque_produtos_path,
  class: "space-y-5" do |form| %>
    
  <% if @produto.errors.any? %>
    <div class="px-4 py-3 bg-red-900/50 border border-red-700 text-red-300 rounded-lg text-sm">
      <p class="font-semibold mb-2">Corrija os erros:</p>
      <ul class="list-disc pl-5">
        <% @produto.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= form.label :nome, "Nome", class: "block text-sm text-zinc-300 mb-1" %>
      <%= form.text_field :nome, class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
    </div>

    <div>
      <%= form.label :codigo, "Código interno", class: "block text-sm text-zinc-300 mb-1" %>
      <%= form.text_field :codigo, class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
    </div>

    <div>
      <%= form.label :categoria, "Categoria", class: "block text-sm text-zinc-300 mb-1" %>
      <%= form.text_field :categoria, class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
    </div>

    <div>
      <%= form.label :unidade_medida, "Unidade de medida", class: "block text-sm text-zinc-300 mb-1" %>
      <%= form.select :unidade_medida,
        [["Unidade", "unidade"], ["Metro", "metro"], ["Caixa", "caixa"], ["Pacote", "pacote"], ["Rolo", "rolo"]],
        {},
        class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
    </div>

    <div>
      <%= form.label :marca, "Marca", class: "block text-sm text-zinc-300 mb-1" %>
      <%= form.text_field :marca, class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
    </div>

    <div>
      <%= form.label :modelo, "Modelo", class: "block text-sm text-zinc-300 mb-1" %>
      <%= form.text_field :modelo, class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
    </div>

    <div>
      <%= form.label :estoque_minimo, "Estoque mínimo", class: "block text-sm text-zinc-300 mb-1" %>
      <%= form.number_field :estoque_minimo, step: "0.001", class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
    </div>

    <div>
      <%= form.label :ativo, "Status", class: "block text-sm text-zinc-300 mb-1" %>
      <%= form.select :ativo, [["Ativo", true], ["Inativo", false]], {}, class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
    </div>
  </div>

  <% if current_user.admin? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= form.label :valor_custo, "Valor de custo", class: "block text-sm text-zinc-300 mb-1" %>
        <%= form.number_field :valor_custo, step: "0.01", class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
      </div>

      <div>
        <%= form.label :valor_venda, "Valor de venda/interno", class: "block text-sm text-zinc-300 mb-1" %>
        <%= form.number_field :valor_venda, step: "0.01", class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
      </div>
    </div>
  <% end %>

  <div>
    <%= form.label :descricao, "Descrição", class: "block text-sm text-zinc-300 mb-1" %>
    <%= form.text_area :descricao, rows: 4, class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
  </div>

  <div class="flex items-center justify-between pt-4">
    <%= link_to "Voltar", estoque_produtos_path, class: "px-4 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-sm" %>
    <%= form.submit "Salvar", class: "px-5 py-2 bg-amber-500 hover:bg-amber-400 text-zinc-950 font-semibold rounded-lg text-sm cursor-pointer" %>
  </div>
<% end %>