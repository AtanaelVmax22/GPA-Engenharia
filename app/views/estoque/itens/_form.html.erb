
<%# ==========================================
    GPA ENGENHARIA - FORMULÁRIO DE ITENS
    Cadastro e edição de equipamentos individuais
    ========================================== %>

<% item = @item %>
<% editando = item.persisted? %>

<%= form_with(
  model: item,
  url: editando ? estoque_item_path(item) : estoque_itens_path,
  method: editando ? :patch : :post,
  class: "gpa-form"
) do |form| %>

  <%# ERROS DE VALIDAÇÃO %>
  <% if item.errors.any? %>
    <div class="gpa-form-errors" role="alert">
      <strong>Não foi possível salvar o item.</strong>

      <ul>
        <% item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# ==========================================
      IDENTIFICAÇÃO DO ITEM
      ========================================== %>

  <section class="gpa-panel">

    <div class="gpa-panel-header">
      <div>
        <h2 class="gpa-panel-title">
          Identificação do Item
        </h2>

        <p class="gpa-panel-subtitle">
          Informações individuais para identificação
          e rastreamento do equipamento.
        </p>
      </div>
    </div>

    <div class="gpa-form-grid">

      <%# PRODUTO %>
      <div class="gpa-field">
        <%= form.label :produto_id, "Produto",
          class: "gpa-form-label" %>

        <%= form.collection_select :produto_id,
          @produtos,
          :id,
          :nome,
          { prompt: "Selecione o produto" },
          class: "gpa-input gpa-select",
          required: true %>
      </div>

      <%# LOCAL %>
      <div class="gpa-field">
        <%= form.label :local_id, "Depósito / Local Atual",
          class: "gpa-form-label" %>

        <%= form.collection_select :local_id,
          @locais,
          :id,
          :nome,
          { include_blank: "Sem local definido" },
          class: "gpa-input gpa-select" %>
      </div>

      <%# CÓDIGO DE PATRIMÔNIO %>
      <div class="gpa-field">
        <%= form.label :codigo_patrimonio, "Código de Patrimônio GPA",
          class: "gpa-form-label" %>

        <%= form.text_field :codigo_patrimonio,
          class: "gpa-input",
          placeholder: "Ex.: GPA-CAM-000001",
          autocomplete: "off" %>

        <p class="gpa-field-hint">
          Identificação interna exclusiva do equipamento.
        </p>
      </div>

      <%# NÚMERO DE SÉRIE %>
      <div class="gpa-field">
        <%= form.label :numero_serie, "Número de Série do Fabricante",
          class: "gpa-form-label" %>

        <%= form.text_field :numero_serie,
          class: "gpa-input",
          placeholder: "Serial original do equipamento",
          autocomplete: "off" %>
      </div>

      <%# MAC %>
      <div class="gpa-field">
        <%= form.label :mac, "Endereço MAC",
          class: "gpa-form-label" %>

        <%= form.text_field :mac,
          class: "gpa-input",
          placeholder: "AA:BB:CC:DD:EE:FF",
          autocomplete: "off" %>
      </div>

      <%# STATUS %>
      <div class="gpa-field">
        <%= form.label :status, "Status do Item",
          class: "gpa-form-label" %>

        <%= form.select :status,
          Estoque::Item.statuses.keys.map { |status|
            [status_item_label(status), status]
          },
          {},
          class: "gpa-input gpa-select" %>
      </div>

    </div>
  </section>

  <%# ==========================================
      COMPRA E GARANTIA
      ========================================== %>

  <section class="gpa-panel">

    <div class="gpa-panel-header">
      <div>
        <h2 class="gpa-panel-title">
          Compra e Garantia
        </h2>

        <p class="gpa-panel-subtitle">
          Dados do fornecedor e prazos de cobertura
          do equipamento.
        </p>
      </div>
    </div>

    <div class="gpa-form-grid">

      <%# FORNECEDOR %>
      <div class="gpa-field">
        <%= form.label :fornecedor_nome, "Fornecedor / Loja",
          class: "gpa-form-label" %>

        <%= form.text_field :fornecedor_nome,
          class: "gpa-input",
          placeholder: "Nome do fornecedor" %>
      </div>

      <%# NOTA FISCAL %>
      <div class="gpa-field">
        <%= form.label :nota_fiscal_numero, "Número da Nota Fiscal",
          class: "gpa-form-label" %>

        <%= form.text_field :nota_fiscal_numero,
          class: "gpa-input",
          placeholder: "Ex.: NF 12345" %>
      </div>

      <%# DATA DA COMPRA %>
      <div class="gpa-field">
        <%= form.label :data_compra, "Data da Compra",
          class: "gpa-form-label" %>

        <%= form.date_field :data_compra,
          class: "gpa-input" %>
      </div>

      <%# DATA DA INSTALAÇÃO %>
      <div class="gpa-field">
        <%= form.label :data_instalacao, "Data da Instalação",
          class: "gpa-form-label" %>

        <%= form.date_field :data_instalacao,
          class: "gpa-input" %>
      </div>

      <%# GARANTIA DA LOJA %>
      <div class="gpa-field">
        <%= form.label :garantia_loja_dias, "Garantia da Loja (dias)",
          class: "gpa-form-label" %>

        <%= form.number_field :garantia_loja_dias,
          min: 0,
          step: 1,
          class: "gpa-input",
          placeholder: "Ex.: 90" %>
      </div>

      <%# GARANTIA DO FABRICANTE %>
      <div class="gpa-field">
        <%= form.label :garantia_fabrica_meses, "Garantia do Fabricante (meses)",
          class: "gpa-form-label" %>

        <%= form.number_field :garantia_fabrica_meses,
          min: 0,
          step: 1,
          class: "gpa-input",
          placeholder: "Ex.: 12" %>
      </div>

    </div>
  </section>

  <%# ==========================================
      INSTALAÇÃO E OBSERVAÇÕES
      ========================================== %>

  <section class="gpa-panel">

    <div class="gpa-panel-header">
      <div>
        <h2 class="gpa-panel-title">
          Instalação e Localização
        </h2>

        <p class="gpa-panel-subtitle">
          Vínculo com o condomínio e informações
          adicionais do equipamento.
        </p>
      </div>
    </div>

    <div class="gpa-form-grid">

      <%# CONDOMÍNIO %>
      <div class="gpa-field gpa-field-full">
        <%= form.label :condominio_id, "Condomínio",
          class: "gpa-form-label" %>

        <%= form.number_field :condominio_id,
          min: 1,
          class: "gpa-input",
          placeholder: "Informe o ID do condomínio" %>

        <p class="gpa-field-hint">
          Por enquanto, informe o ID do condomínio.
          A seleção por lista será implementada
          na próxima etapa.
        </p>
      </div>

      <%# OBSERVAÇÕES %>
      <div class="gpa-field gpa-field-full">
        <%= form.label :observacao, "Observações",
          class: "gpa-form-label" %>

        <%= form.text_area :observacao,
          rows: 5,
          class: "gpa-input gpa-textarea",
          placeholder: "Detalhes do item, instalação, defeito ou garantia..." %>
      </div>

    </div>
  </section>

  <%# ==========================================
      AÇÕES
      ========================================== %>

  <div class="gpa-form-footer">

    <%= link_to "Cancelar",
      estoque_itens_path,
      class: "gpa-btn gpa-btn-secondary" %>

    <%= form.submit(
      editando ? "Salvar Alterações" : "Cadastrar Item",
      class: "gpa-btn gpa-btn-primary"
    ) %>

  </div>

<% end %>
