<% content_for :page_title do %>
  QR Code do Estoque
<% end %>

<%
  qr_url = estoque_scan_local_url(qr_token: @local.qr_token)
  qr = RQRCode::QRCode.new(qr_url)
%>

<style>
  @media print {
    aside,
    header,
    footer,
    .no-print {
      display: none !important;
    }

    .ml-64 {
      margin-left: 0 !important;
    }

    main {
      padding: 0 !important;
    }

    body,
    html {
      background: #ffffff !important;
      color: #000000 !important;
    }

    .print-area {
      max-width: 100% !important;
      margin: 0 auto !important;
      padding: 24px !important;
    }

    .print-card {
      background: #ffffff !important;
      color: #000000 !important;
      border: none !important;
      box-shadow: none !important;
    }

    .print-url {
      display: none !important;
    }
  }
</style>

<div class="max-w-xl mx-auto space-y-6 print-area">
  <div class="flex items-start justify-between gap-4 no-print">
    <div>
      <h2 class="text-2xl font-bold text-zinc-100">QR Code do Estoque</h2>
      <p class="text-sm text-zinc-500"><%= @local.nome %></p>
    </div>

    <div class="flex items-center gap-2">
      <button
        type="button"
        onclick="window.print()"
        class="px-4 py-2 bg-amber-500 hover:bg-amber-400 text-zinc-950 font-semibold rounded-lg text-sm"
      >
        Imprimir
      </button>

      <%= link_to "Voltar",
        estoque_local_path(@local),
        class: "inline-block px-4 py-2 bg-zinc-800 hover:bg-zinc-700 rounded-lg text-sm text-zinc-100" %>
    </div>
  </div>

  <div class="bg-white text-zinc-900 rounded-2xl border border-zinc-200 shadow-xl p-8 print-card">
    <div class="text-center mb-6">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-amber-500 text-zinc-900 font-black text-base mb-3">
        GPA
      </div>

      <h3 class="text-2xl font-bold text-zinc-900">QR Code do Estoque</h3>
      <p class="text-base text-zinc-600 mt-1"><%= @local.nome %></p>

      <% if @local.tipo.present? %>
        <p class="text-sm text-zinc-500 capitalize mt-1">
          Tipo: <%= @local.tipo.humanize %>
        </p>
      <% end %>
    </div>

    <div class="bg-white rounded-xl p-6 flex justify-center">
      <%= raw qr.as_svg(
        module_size: 6,
        standalone: true,
        use_path: true,
        color: "000000",
        fill: "ffffff",
        shape_rendering: "crispEdges",
        viewbox: true
      ) %>
    </div>

    <div class="mt-6 print-url">
      <div class="text-sm font-semibold text-zinc-700 mb-1">Link do QR Code</div>
      <div class="bg-zinc-100 border border-zinc-200 rounded-xl p-4 text-sm text-zinc-700 break-all">
        <%= qr_url %>
      </div>
    </div>
  </div>

  <div class="no-print">
    <%= link_to "Voltar para o estoque",
      estoque_local_path(@local),
      class: "inline-block px-4 py-2 bg-zinc-800 hover:bg-zinc-700 rounded-lg text-sm text-zinc-100" %>
  </div>
</div>