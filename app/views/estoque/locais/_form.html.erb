<%= form_with model: @local,
  url: @local.persisted? ? estoque_local_path(@local) : estoque_locais_path,
  class: "space-y-5" do |form| %>
  <% if @local.errors.any? %>
    <div class="px-4 py-3 bg-red-900/50 border border-red-700 text-red-300 rounded-lg text-sm">
      <p class="font-semibold mb-2">Corrija os erros:</p>
      <ul class="list-disc pl-5">
        <% @local.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= form.label :nome, "Nome do estoque", class: "block text-sm text-zinc-300 mb-1" %>
      <%= form.text_field :nome, class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
    </div>

    <div>
      <%= form.label :tipo, "Tipo", class: "block text-sm text-zinc-300 mb-1" %>
      <%= form.select :tipo,
        Estoque::Local.tipos.keys.map { |tipo| [tipo.humanize, tipo] },
        {},
        class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
    </div>

    <div>
      <%= form.label :cidade, "Cidade", class: "block text-sm text-zinc-300 mb-1" %>
      <%= form.text_field :cidade, class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
    </div>

    <div>
      <%= form.label :bairro, "Bairro", class: "block text-sm text-zinc-300 mb-1" %>
      <%= form.text_field :bairro, class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
    </div>

    <div class="md:col-span-2">
      <%= form.label :endereco, "Endereço", class: "block text-sm text-zinc-300 mb-1" %>
      <%= form.text_field :endereco, class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
    </div>

    <div>
  <%= form.label :responsavel_ids, "Responsáveis pelo depósito", class: "block text-sm text-zinc-300 mb-1" %>

  <%= form.collection_select :responsavel_ids,
    @usuarios,
    :id,
    :nome_para_select,
    {},
    {
      multiple: true,
      size: 6,
      class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100"
    } %>

  <p class="text-xs text-zinc-500 mt-1">
    Segure CTRL para selecionar mais de um. Limite máximo: 3 responsáveis por depósito.
  </p>
    </div>

    <div>
      <%= form.label :ativo, "Status", class: "block text-sm text-zinc-300 mb-1" %>
      <%= form.select :ativo, [["Ativo", true], ["Inativo", false]], {}, class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
    </div>
  </div>

  <div>
    <%= form.label :descricao, "Descrição", class: "block text-sm text-zinc-300 mb-1" %>
    <%= form.text_area :descricao, rows: 4, class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
  </div>

  

  <div class="flex items-center justify-between pt-4">
    <%= link_to "Voltar", estoque_locais_path, class: "px-4 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-sm" %>
    <%= form.submit "Salvar", class: "px-5 py-2 bg-amber-500 hover:bg-amber-400 text-zinc-950 font-semibold rounded-lg text-sm cursor-pointer" %>
  </div>
<% end %>