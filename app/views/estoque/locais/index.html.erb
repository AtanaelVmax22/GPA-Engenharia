<% content_for :page_title do %>
  Estoques
<% end %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-bold text-zinc-100">Estoques</h2>
      <p class="text-sm text-zinc-500">Locais físicos, técnicos, veículos, obras e regionais.</p>
    </div>

    <% if current_user.admin? %>
      <%= link_to "Novo estoque", new_estoque_local_path,
        class: "px-4 py-2 bg-amber-500 hover:bg-amber-400 text-zinc-950 font-semibold rounded-lg text-sm" %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
    <% @locais.each do |local| %>
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-5 hover:border-amber-500/60 transition">
        <div class="flex items-start justify-between gap-4">
          <%= link_to estoque_local_path(local), class: "flex-1 min-w-0" do %>
            <div class="font-bold text-zinc-100 text-lg truncate">
              <%= local.nome %>
            </div>

            <div class="text-sm text-zinc-500 capitalize mt-1">
              <%= local.tipo.humanize %>
            </div>
          <% end %>

          <span class="text-xs px-2 py-1 rounded <%= local.ativo? ? 'bg-emerald-900/50 text-emerald-300' : 'bg-red-900/50 text-red-300' %>">
            <%= local.ativo? ? "Ativo" : "Inativo" %>
          </span>
        </div>

        <%= link_to estoque_local_path(local), class: "block text-sm text-zinc-500 mt-5 hover:text-zinc-300" do %>
          <%= [local.bairro, local.cidade].compact_blank.join(" - ").presence || "Sem localização informada" %>
        <% end %>

        <% if current_user.admin? %>
          <div class="mt-5 pt-4 border-t border-zinc-800 flex items-center justify-end gap-2">
            <%= link_to "Abrir",
              estoque_local_path(local),
              class: "px-3 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs font-medium" %>

            <%= link_to "Editar",
              edit_estoque_local_path(local),
              class: "px-3 py-2 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 text-xs font-semibold" %>

            <%= button_to "Excluir",
              estoque_local_path(local),
              method: :delete,
              form: {
                data: {
                  turbo_confirm: "Tem certeza que deseja excluir/inativar este estoque? Ele não será apagado do histórico, apenas removido da lista ativa."
                },
                class: "inline"
              },
              class: "px-3 py-2 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 text-xs font-semibold border-0 cursor-pointer" %>
          </div>
        <% else %>
          <div class="mt-5 pt-4 border-t border-zinc-800 flex items-center justify-end">
            <%= link_to "Abrir estoque",
              estoque_local_path(local),
              class: "px-3 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs font-medium" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @locais.empty? %>
    <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-8 text-center text-zinc-500">
      Nenhum estoque cadastrado.
    </div>
  <% end %>
</div>