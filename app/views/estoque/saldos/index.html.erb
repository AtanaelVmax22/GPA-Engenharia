<% content_for :page_title do %>
  Saldos do Estoque
<% end %>

<div class="space-y-6">
  <div>
    <h2 class="text-2xl font-bold text-zinc-100">Saldos por estoque</h2>
    <p class="text-sm text-zinc-500">Quantidade de cada produto em cada estoque/local.</p>
  </div>

  <div class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-zinc-800/70 text-zinc-400">
        <tr>
          <th class="px-4 py-3 text-left">Produto</th>
          <th class="px-4 py-3 text-left">Estoque</th>
          <th class="px-4 py-3 text-left">Tipo</th>
          <th class="px-4 py-3 text-right">Quantidade</th>
        </tr>
      </thead>

      <tbody class="divide-y divide-zinc-800">
        <% @saldos.each do |saldo| %>
          <tr class="hover:bg-zinc-800/40">
            <td class="px-4 py-3">
              <%= link_to saldo.produto.nome, estoque_produto_path(saldo.produto), class: "text-amber-400 hover:text-amber-300" %>
            </td>

            <td class="px-4 py-3">
              <%= link_to saldo.local.nome, estoque_local_path(saldo.local), class: "text-zinc-100 hover:text-amber-300" %>
            </td>

            <td class="px-4 py-3 text-zinc-400"><%= saldo.local.tipo.humanize %></td>
            <td class="px-4 py-3 text-right text-zinc-100 font-semibold"><%= formatar_quantidade(saldo.quantidade) %></td>
          </tr>
        <% end %>

        <% if @saldos.empty? %>
          <tr>
            <td colspan="4" class="px-4 py-6 text-center text-zinc-500">
              Nenhum saldo registrado.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "shared/pagination", pagination: @saldos_pagination %>
  </div>
</div>