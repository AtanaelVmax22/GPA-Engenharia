<% content_for :page_title do %>
  Nova Movimentação
<% end %>

<div class="max-w-3xl mx-auto space-y-6">
  <div>
    <h2 class="text-2xl font-bold text-zinc-100">Nova movimentação</h2>
    <p class="text-sm text-zinc-500">
      Registre entrada, saída, transferência, devolução, uso em serviço ou ajuste de inventário.
    </p>
  </div>

  <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
    <%= form_with scope: :estoque_movimentacao, url: estoque_movimentacoes_path, class: "space-y-5", data: { controller: "movimentacao-estoque" } do |form| %>

      <% if @produto_selecionado.present? %>
        <div>
          <label class="block text-sm text-zinc-300 mb-1">Produto</label>

          <div class="w-full px-4 py-3 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100">
            <div class="font-semibold">
              <%= @produto_selecionado.nome %>
            </div>

            <% if @produto_selecionado.codigo.present? || @produto_selecionado.categoria.present? %>
              <div class="text-xs text-zinc-500 mt-1">
                <%= [@produto_selecionado.codigo, @produto_selecionado.categoria].compact_blank.join(" · ") %>
              </div>
            <% end %>
          </div>

          <%= form.hidden_field :produto_id,
            value: @produto_selecionado.id,
            data: { movimentacao_estoque_target: "produto" } %>
        </div>
      <% else %>
        <div>
          <%= form.label :produto_id, "Produto", class: "block text-sm text-zinc-300 mb-1" %>

          <%= form.collection_select :produto_id,
            @produtos,
            :id,
            :nome,
            { prompt: "Selecione o produto" },
            class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100",
            data: {
              movimentacao_estoque_target: "produto",
              action: "change->movimentacao-estoque#verificar"
            } %>
        </div>
      <% end %>

      <div>
        <%= form.label :tipo, "Tipo de movimentação", class: "block text-sm text-zinc-300 mb-1" %>

        <%= form.select :tipo,
          Estoque::Movimentacao.tipos.keys.map { |tipo| [tipo.humanize, tipo] },
          { prompt: "Selecione o tipo" },
          class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100",
          data: {
            movimentacao_estoque_target: "tipo",
            action: "change->movimentacao-estoque#verificar"
          } %>
      </div>

      <div>
        <%= form.label :quantidade, "Quantidade", class: "block text-sm text-zinc-300 mb-1" %>

        <%= form.number_field :quantidade,
          step: "0.001",
          min: "0.001",
          class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100",
          data: {
            movimentacao_estoque_target: "quantidade",
            action: "input->movimentacao-estoque#verificar"
          } %>

        <div
          class="hidden mt-2 text-sm rounded-lg border px-3 py-2"
          data-movimentacao-estoque-target="aviso"
        ></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= form.label :origem_local_id, "Estoque de origem", class: "block text-sm text-zinc-300 mb-1" %>

          <%= form.collection_select :origem_local_id,
            @locais,
            :id,
            :nome,
            { include_blank: "Sem origem", selected: @origem_local_selecionado&.id },
            class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100",
            data: {
              movimentacao_estoque_target: "origem",
              action: "change->movimentacao-estoque#verificar"
            } %>
        </div>

        <div>
          <%= form.label :destino_local_id, "Estoque de destino", class: "block text-sm text-zinc-300 mb-1" %>

          <%= form.collection_select :destino_local_id,
            @locais,
            :id,
            :nome,
            { include_blank: "Sem destino", selected: @destino_local_selecionado&.id },
            class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
        </div>
      </div>

      <div class="bg-zinc-950 border border-zinc-800 rounded-lg p-4 text-sm text-zinc-400">
        <p class="font-semibold text-zinc-300 mb-2">Regras rápidas:</p>
        <p>Entrada: informe destino.</p>
        <p>Saída, perda, defeito e uso em serviço: informe origem.</p>
        <p>Transferência e devolução: informe origem e destino.</p>
        <p>Ajuste e inventário: informe destino e a quantidade final contada.</p>
      </div>

      <div>
        <%= form.label :observacao, "Observação", class: "block text-sm text-zinc-300 mb-1" %>

        <%= form.text_area :observacao,
          rows: 4,
          class: "w-full px-4 py-2 rounded-lg bg-zinc-950 border border-zinc-700 text-zinc-100" %>
      </div>

      <div class="flex items-center justify-between pt-4">
        <%= link_to "Voltar",
          request.referer.presence || estoque_movimentacoes_path,
          class: "px-4 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-sm" %>

        <%= form.submit "Registrar movimentação",
          class: "px-5 py-2 bg-amber-500 hover:bg-amber-400 text-zinc-950 font-semibold rounded-lg text-sm cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>