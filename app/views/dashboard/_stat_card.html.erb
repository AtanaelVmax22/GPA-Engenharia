
<% icon_style = {
  "amber" => "",
  "blue" => "is-blue",
  "emerald" => "is-emerald",
  "red" => "is-red"
}.fetch(color.to_s, "") %>

<article class="gpa-stat-card">
  <div class="min-w-0">

    <p class="gpa-stat-label">
      <%= label %>
    </p>

    <p class="gpa-stat-value">
      <%= value %>
    </p>

    <p class="gpa-stat-sub">
      <%= sub %>
    </p>

  </div>

  <span
    class="gpa-stat-icon <%= icon_style %>"
    aria-hidden="true"
  >
    <%= gpa_icon(icon) %>
  </span>
</article>
